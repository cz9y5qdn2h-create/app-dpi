PORT=3001
FRONTEND_URL=http://localhost:5173

# CORS — origines autorisées à appeler l'API en cross-origin (séparées par
# des virgules). Sans valeur, le serveur retombe sur le domaine de
# production connu — jamais sur "tout autoriser".
# ALLOWED_ORIGINS=https://iralink-agency.dippro.business

# Chiffrement des tokens OAuth (Google Drive / OneDrive de la veille
# documentaire) — 32 octets aléatoires en hex. Sans valeur, le serveur
# utilise un repli dérivé de SUPABASE_URL (non secret) et le journalise en
# erreur : à définir avant toute mise en production réelle de la veille.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MONITOR_ENCRYPTION_KEY=<32 octets en hex>

# Supabase
SUPABASE_URL=<obtenir dans Supabase > Settings > API>
SUPABASE_ANON_KEY=<clé anon — Supabase > Settings > API>
# SUPABASE_SERVICE_ROLE_KEY=<obtenir dans Supabase > Settings > API>

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Email Resend — tous les envois transactionnels (notifications franchisés,
# réinitialisation de mot de passe, invitations avocat/franchiseur, bugs) +
# formulaire de contact public. Un franchiseur peut définir sa propre clé
# (Paramètres > Emails) qui prévaut sur RESEND_API_KEY pour ses envois.
# RESEND_API_KEY=re_...
# RESEND_SENDER_NAME=DIPpro
# RESEND_SENDER_EMAIL=contact@dippro.business
# RESEND_FROM_EMAIL=DIPpro <contact@dippro.business>
# RESEND_CONTACT_TO_EMAIL=theo@iralink-agency.com

# Admin
ADMIN_EMAIL=<email admin>
ADMIN_PASSWORD=<mot de passe fort — jamais de valeur par défaut>

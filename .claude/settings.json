{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "french",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(node *)",
      "Bash(cd *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(jq *)",
      "mcp__supabase__list_tables",
      "mcp__supabase__get_logs",
      "mcp__supabase__execute_sql",
      "mcp__supabase__get_advisors",
      "mcp__supabase__get_publishable_keys",
      "mcp__supabase__apply_migration",
      "mcp__supabase__get_project_url",
      "mcp__supabase__list_migrations",
      "mcp__supabase__list_extensions",
      "mcp__supabase__generate_typescript_types",
      "mcp__github__list_pull_requests",
      "mcp__github__pull_request_read",
      "mcp__github__get_file_contents",
      "mcp__github__list_commits",
      "mcp__github__get_commit"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(jq -r '.tool_input.file_path // .tool_response.filePath // empty' 2>/dev/null); if echo \"$file\" | grep -qE '^/home/user/app-dpi/frontend/'; then cd /home/user/app-dpi/frontend && npm run build 2>&1 | tail -5 | jq -Rs '{systemMessage: (\"Build: \" + .)}'; fi",
            "timeout": 60,
            "statusMessage": "Verification du build frontend..."
          }
        ]
      }
    ]
  }
}
